module dual_port_ram (
    input logic clk,
    input logic rst,

    // Port A
    input logic wr_en_a,
    input logic rd_en_a,
    input logic [3:0] addr_a,
    input logic [7:0] din_a,
    output logic [7:0] dout_a,

    // Port B
    input logic wr_en_b,
    input logic rd_en_b,
    input logic [3:0] addr_b,
    input logic [7:0] din_b,
    output logic [7:0] dout_b
);

    logic [7:0] mem [0:15];
    integer i;

    always_ff @(posedge clk) begin

        if (rst) begin
            dout_a <= 0;
            dout_b <= 0;

            for (i = 0; i < 16; i = i + 1)
                mem[i] <= 0;
        end

        else begin

            if (wr_en_a)
                mem[addr_a] <= din_a;

            if (wr_en_b)
                mem[addr_b] <= din_b;

            if (rd_en_a) begin
                if (wr_en_a)
                    dout_a <= din_a;
                else
                    dout_a <= mem[addr_a];
            end

            if (rd_en_b) begin
                if (wr_en_b)
                    dout_b <= din_b;
                else
                    dout_b <= mem[addr_b];
            end

        end
    end

endmodule
